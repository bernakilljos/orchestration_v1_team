# =====================================================
# deploy-config.env.example
# Copy this file to .claude/deploy-config.env
# DO NOT commit deploy-config.env to git
# =====================================================

# Deploy environment (dev | stg | prod)
TARGET_ENV=dev

# Server connection
# REMOTE_HOST=your-server.example.com
REMOTE_HOST=
# REMOTE_USER=ec2-user
REMOTE_USER=
# APP_PATH=/home/ec2-user/app
APP_PATH=
# SERVICE_PORT=8080
SERVICE_PORT=

# PM2 app name
# PM2_APP_NAME=my-app
PM2_APP_NAME=

# Build command
BUILD_CMD=npm run build

# Jenkins CI/CD (optional)
# JENKINS_HOST=your-jenkins.example.com
JENKINS_HOST=
# JENKINS_USER=admin
JENKINS_USER=
JENKINS_TOKEN=
# JOB_NAME=my-app-deploy
JOB_NAME=

# Notification (slack | teams | both | none)
NOTIFY_TYPE=none
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
NOTIFY_MENTION=
