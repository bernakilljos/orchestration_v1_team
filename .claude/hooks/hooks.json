{
  "schema_version": "1.0",
  "description": "Claude Code 훅 등록 manifest — .claude/settings.json 의 hooks 설정과 동기화",
  "notes": "이 파일은 문서/manifest 역할. 실제 실행 등록은 .claude/settings.json 에서 관리.",

  "hooks": [
    {
      "id": "protect-critical-files",
      "event": "PreToolUse",
      "matcher": "Edit|Write",
      "script": ".claude/hooks/protect-critical-files.sh",
      "description": "CLAUDE.md, settings.json 등 보호 파일 수정 차단",
      "enabled": true
    },
    {
      "id": "block-visible-windows",
      "event": "PreToolUse",
      "matcher": "Bash",
      "script": ".claude/hooks/block-visible-windows.sh",
      "description": "GUI 윈도우를 띄우는 명령 차단 (Windows headless 환경)",
      "enabled": true
    },
    {
      "id": "check-korean-only",
      "event": "PostToolUse",
      "matcher": "Edit|Write",
      "script": ".claude/hooks/check-korean-only.sh",
      "description": "파일 저장 후 한글 전용 규칙 검사",
      "enabled": true
    },
    {
      "id": "orca-heartbeat",
      "event": "PostToolUse",
      "matcher": ".*",
      "command": "bash -c 'test -d .claude && date +%Y-%m-%dT%H:%M:%S > .claude/orca-heartbeat'",
      "description": "모든 툴 사용 후 orca heartbeat 갱신 — 워커 생존 신호 (5분 무갱신 시 워커 자동 종료)",
      "enabled": true
    }
  ],

  "disabled": [],

  "plugin_hooks": {
    "exec_session_guard": [
      {
        "id": "session-guard-stop",
        "event": "Stop",
        "script": "plugins/exec_session_guard/hooks/stop-snapshot.sh Stop",
        "description": "턴 종료마다 세션 스냅샷 메타 기록 — 토큰 소진 대비"
      },
      {
        "id": "session-guard-precompact",
        "event": "PreCompact",
        "script": "plugins/exec_session_guard/hooks/stop-snapshot.sh PreCompact",
        "description": "컨텍스트 압축 직전 스냅샷 저장"
      },
      {
        "id": "session-guard-sessionend",
        "event": "SessionEnd",
        "script": "plugins/exec_session_guard/hooks/stop-snapshot.sh SessionEnd",
        "description": "세션 종료 시 최종 스냅샷"
      }
    ]
  },

  "extension_points": {
    "PreToolUse": [
      "추가 가능: block_dangerous_bash.py (위험 명령 차단)",
      "추가 가능: log_bash_command.py (명령 로깅)"
    ],
    "PostToolUse": [
      "추가 가능: post_write_pycheck.py (Python 파일 저장 후 문법 검사)",
      "추가 가능: markdown_formatter.py (마크다운 포맷 통일)"
    ]
  }
}
