# Codex Standalone 환경변수
# 이 파일을 .env 로 복사한 후 값을 입력하세요.

# REQUIRED: OpenAI API 키
# https://platform.openai.com/account/api-keys 에서 생성
OPENAI_API_KEY=sk-YOUR_API_KEY_HERE

# OPTIONAL: Codex 모델 선택 (기본값: gpt-4)
# 옵션: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# CODEX_MODEL=gpt-4

# OPTIONAL: 일일 토큰 한도 (USD, 기본값: 무제한)
# 초과 시 codex-go 명령이 경고 메시지 출력
# 예: CODEX_DAILY_LIMIT_USD=10
# CODEX_DAILY_LIMIT_USD=10

# OPTIONAL: 프로젝트 이름 (로그에 기록)
# PROJECT_NAME=my-project
